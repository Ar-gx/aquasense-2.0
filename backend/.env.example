# =============================================================
# AquaSense AI — backend environment template
# Copy this file to `.env` and fill in what you have.
# The application MUST work even if every key below is empty.
# =============================================================

# --- Database -------------------------------------------------
# Leave empty to use SQLite (recommended for the hackathon demo).
# Example for PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/aquasense
DATABASE_URL=

# --- OpenWeather (current conditions + 5 day / 3h forecast) ---
OPENWEATHER_API_KEY=

# --- data.gov.in (district daily rainfall, groundwater, crop APY)
DATA_GOV_API_KEY=
DATA_GOV_RAINFALL_ID=6c05cd1b-ed59-40c2-bc31-e314f39c6971
DATA_GOV_GW_ID=1de54e45-5df3-4626-9167-a4c8ad2309e0
DATA_GOV_CROP_ID=35be999b-0208-4354-b557-f6ca9a5355de

# --- USDA NASS Quick Stats (OPTIONAL, free key) ----------------
# Register at https://quickstats.nass.usda.gov/api — without a key
# the app falls back to the bundled USDA NASS historical extract.
USDA_NASS_API_KEY=

# --- NASA POWER (no key required) -----------------------------
NASA_POWER_ENABLED=true

# --- Open-Meteo (no key required) -----------------------------
OPEN_METEO_ENABLED=true

# --- Nominatim / OpenStreetMap geocoding (no key required) ----
GEOCODER_ENABLED=true

# --- Behaviour ------------------------------------------------
# Force simulated weather even when live APIs are reachable (demo mode).
FORCE_SIMULATED_WEATHER=false
# Cache TTL for slow reference APIs, seconds
REFERENCE_CACHE_TTL=21600
